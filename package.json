{
  "name": "@neptrack/core",
  "version": "0.2.0",
  "description": "Node.js SDK for the NepTrack GPS tracking platform — REST API + real-time Data Stream.",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "neptrack",
    "gps",
    "tracking",
    "vehicle",
    "fleet",
    "sdk",
    "rest",
    "socket.io",
    "real-time"
  ],
  "homepage": "https://neptrack.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NepTrack/neptrack_nodejs.git"
  },
  "bugs": {
    "url": "https://github.com/NepTrack/neptrack_nodejs/issues"
  },
  "license": "Apache-2.0",
  "author": "NepTrack",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm run build"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "socket.io-client": "^2.4.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/socket.io-client": "^1.4.36",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0"
  }
}
